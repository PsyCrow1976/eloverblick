# ElOverblik Customer API refresh token (never commit the real value)
ELOVERBLIK_TOKEN=

# Existing PostgreSQL server (not created by this compose file)
POSTGRES_HOST=192.168.1.80
POSTGRES_PORT=5432
POSTGRES_USER=home
POSTGRES_PASSWORD=
POSTGRES_DB=home

# FastHTML listen address. Docker Compose publishes this host port as well.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Day-ahead spot prices (Energi Data Service). DK2 is east Denmark (Copenhagen).
PRICE_AREA=DK2
JOB_INTERVAL_HOURS=6
JOB_LOG_PATH=/var/log/eloverblik/prices.log
# JOB_INSTANCE=eloverblick
